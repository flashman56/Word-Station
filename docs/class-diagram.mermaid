classDiagram
    class SpeechModule {
        <<module singleton>>
        +string[] voicesCache
        +void ensureListener()
        +pickVoice() SpeechSynthesisVoice
        +subscribe(fn) unsubscribe
    }
    class useSpeech {
        +boolean supported
        +boolean speaking
        +string voiceLang
        +speak(text, opts) void
        +cancel() void
    }
    class SpeakerButton {
        +string text
        +string size
        +boolean stopPropagation
        +string title
        +number rate
        +string lang
    }
    class vocab {
        <<pure functions>>
        +estimateVocabulary(words, records, opts) VocabResult
        +referenceOf(estimate) ReferenceBand
    }
    class VocabCard {
        +VocabResult result
        +boolean compact
    }
    class etym {
        <<pure + lazy>>
        +composeEtymology(morph) EtymEntry
        +loadEtymologyMap() Promise
        +resolveEtymology(morph) Promise
    }
    class EtymologyPanel {
        +Morph morph
        +EtymEntry entry
        +boolean defaultOpen
    }
    class EtymEntry {
        +string origin
        +string proto
        +string protoGloss
        +boolean pie
        +string story
        +TimelineStep[] timeline
        +Cognate[] cognates
        +string source
    }
    class VocabResult {
        +number estimate
        +number low
        +number high
        +boolean sufficient
        +number sampleSize
        +VocabBand[] bands
        +ReferenceBand reference
    }
    class VocabBand {
        +number lo
        +number hi
        +number libraryN
        +number studiedN
        +number knownP
        +number estKnown
        +boolean included
    }
    class Morph {
        +string id
        +string type
        +string form
        +string display
        +string[] variants
        +string gloss
        +string glossEn
        +string origin
        +string note
    }

    useSpeech ..> SpeechModule : uses
    SpeakerButton ..> useSpeech : uses
    VocabCard ..> vocab : uses
    EtymologyPanel ..> etym : uses
    etym ..> Morph : reads
    etym --> EtymEntry : produces
    vocab --> VocabResult : produces
    VocabResult --> VocabBand : contains
